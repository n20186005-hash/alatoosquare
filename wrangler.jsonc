{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "ala-too-square",
  "compatibility_date": "2026-09-07",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist"
  },
  "not_found_handling": "404-page",
  "observability": {
    "enabled": true
  }
}
