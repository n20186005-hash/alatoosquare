---
import { attraction, imageSources, sources, contentUpdated } from '../data/site';
import { content } from '../content';
import { localizedPath, type Locale } from '../i18n';

interface Props {
  locale: Locale;
}

const { locale } = Astro.props;
const c = content[locale].home;
const homeHref = localizedPath(locale, '/');
const guardHref = localizedPath(locale, content[locale].articles.guard.slug);
const transportHref = localizedPath(locale, content[locale].articles.transport.slug);
const nearbyHref = localizedPath(locale, content[locale].articles.nearby.slug);
const ratingLine = `${attraction.rating.value} / 5`;
const ratingCountLine = `${attraction.rating.count.toLocaleString('en-US')}`;
---

<section id="top" class="hero-mask relative min-h-[92vh] overflow-hidden bg-[#332820] text-white">
  <img
    src={imageSources[0].src}
    alt={imageSources[0].alt}
    width="1280"
    height="960"
    fetchpriority="high"
    class="absolute inset-0 h-full w-full object-cover object-center"
  />
  <div class="relative z-10 mx-auto flex min-h-[92vh] max-w-[1500px] items-end px-5 pb-12 pt-36 md:px-10 md:pb-16">
    <div class="grid w-full gap-8 lg:grid-cols-[1fr_350px] lg:items-end">
      <div>
        <div class="mb-5 flex items-center gap-3">
          <span class="h-px w-12 bg-[#e6b95f]"></span>
          <span class="eyebrow text-[#f4d89c]">{c.hero.eyebrow}</span>
        </div>
        <h1 class="display max-w-6xl font-bold leading-[1.02]">
          <span class="block text-[clamp(3.4rem,10vw,8rem)]">{c.hero.title}</span>
          <span class="mt-4 block text-[clamp(1.2rem,2.4vw,2rem)] font-semibold tracking-tight text-[#f4d89c]">{c.hero.subtitle}</span>
        </h1>
        <p class="mt-6 max-w-3xl text-lg text-white/85 md:text-2xl">{c.hero.lead}</p>
        <div class="mt-7 flex flex-wrap gap-3 text-sm font-bold">
          <a href={attraction.mapsUrl} target="_blank" rel="noopener noreferrer" class="rounded-full bg-[#e6b95f] px-6 py-3 text-[#201b17] transition hover:bg-[#f4d89c]">{c.hero.ctaMap}</a>
          <a href="#history" class="rounded-full border border-white/40 px-6 py-3 text-white transition hover:bg-white/10">{c.hero.ctaHistory}</a>
        </div>
      </div>
      <aside class="border-l border-white/30 pl-6 text-sm text-white/85">
        <div class="mb-6 text-5xl font-light text-[#f4d89c]">{c.hero.coords}</div>
        <dl class="grid grid-cols-2 gap-y-3">
          {c.hero.facts.map((f) => (
            <dt>{f.label}</dt><dd class="text-right font-bold text-white">{f.value}</dd>
          ))}
        </dl>
        <p class="mt-4 text-xs text-white/55">{ratingLine} · {ratingCountLine}</p>
      </aside>
    </div>
  </div>
  <div class="absolute bottom-0 left-0 right-0 z-20 knot-line text-[#e6b95f]"></div>
</section>

<section id="about" class="grid-paper px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <nav aria-label="Breadcrumb" class="mb-10 flex flex-wrap items-center gap-2 text-sm font-bold text-black/55">
      <span class="text-black/70">{c.breadcrumb.home}</span>
      <span aria-hidden="true">›</span>
      <span class="text-black/40">{c.breadcrumb.city}</span>
      <span aria-hidden="true">›</span>
      <span class="text-black/40">{c.breadcrumb.country}</span>
    </nav>
    <div class="grid gap-12 lg:grid-cols-[.7fr_1.3fr]">
      <div>
        <p class="eyebrow text-[var(--red)]">{c.intro.eyebrow}</p>
        <h2 class="display mt-5 text-5xl font-bold md:text-7xl">{c.intro.title}</h2>
        <p class="mt-6 text-base font-bold uppercase tracking-widest text-black/40">{c.intro.subtitle}</p>
      </div>
      <div class="grid gap-6 md:grid-cols-2">
        {c.intro.paras.map((p, i) => (
          <p class={i < 2 ? 'text-xl leading-relaxed md:text-2xl' : 'text-base leading-relaxed text-black/65 md:text-lg'}>{p}</p>
        ))}
      </div>
    </div>
  </div>
</section>

<section id="history" class="section-rule px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="mb-14 flex flex-col justify-between gap-6 md:flex-row md:items-end">
      <div>
        <p class="eyebrow text-[var(--red)]">{c.history.eyebrow}</p>
        <h2 class="display mt-4 text-5xl font-bold md:text-7xl">{c.history.title}</h2>
      </div>
      <p class="max-w-xl text-black/60">{c.history.note}</p>
    </div>
    <div class="grid border-y border-black/15 md:grid-cols-3">
      {c.history.timeline.map((t, i) => (
        <article class={i === 0 ? 'p-7 md:border-r md:border-black/15 md:p-10' : 'border-t border-black/15 p-7 md:border-r md:border-black/15 md:p-10 md:border-t-0'}>
          <div class="text-5xl font-light text-[var(--red)]">{t.year}</div>
          <h3 class="mt-5 text-xl font-bold">{t.title}</h3>
          <p class="mt-3 text-black/65">{t.text}</p>
        </article>
      ))}
    </div>
    <div class="mt-10 grid gap-8 rounded-[2rem] bg-[#201b17] p-8 text-white md:grid-cols-[1fr_1.1fr] md:p-12">
      <div>
        <p class="eyebrow text-[#e6b95f]">{c.history.featureEyebrow}</p>
        <h3 class="display mt-4 text-4xl font-bold md:text-5xl">{c.history.featureTitle}</h3>
      </div>
      <p class="text-lg text-white/75">{c.history.featureText}</p>
    </div>
  </div>
</section>

<section id="monuments" class="px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="mb-12">
      <p class="eyebrow text-[var(--red)]">{c.monuments.eyebrow}</p>
      <h2 class="display mt-4 text-5xl font-bold md:text-7xl">{c.monuments.title}</h2>
      <p class="mt-6 max-w-2xl text-black/60">{c.monuments.note}</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {c.monuments.items.map((m) => (
        <article class="card-stone rounded-3xl p-7">
          <h3 class="text-xl font-bold">{m.title}</h3>
          <p class="mt-3 text-black/60">{m.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="guard" class="red-panel px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div>
        <p class="eyebrow text-[#e6b95f]">{c.guard.eyebrow}</p>
        <h2 class="display mt-5 text-5xl font-bold md:text-7xl">{c.guard.title}</h2>
        <p class="mt-6 max-w-md text-white/70">{c.guard.intro}</p>
        <a href={guardHref} class="mt-7 inline-block rounded-full bg-[#e6b95f] px-6 py-3 text-sm font-bold text-[#201b17] transition hover:bg-[#f4d89c]">{c.guard.linkLabel}</a>
      </div>
      <div>
        <dl class="grid gap-px overflow-hidden rounded-[2rem] bg-white/20 sm:grid-cols-2">
          {c.guard.facts.map((f) => (
            <div class="bg-[var(--red-deep)] p-7">
              <dt class="text-xs font-bold uppercase tracking-widest text-white/55">{f.label}</dt>
              <dd class="mt-2 text-2xl font-bold text-white">{f.value}</dd>
            </div>
          ))}
        </dl>
        <ul class="mt-6 space-y-3 text-white/75">
          {c.guard.tips.map((t) => <li class="border-l-2 border-[#e6b95f] pl-4">{t}</li>)}
        </ul>
        <p class="mt-6 text-xs text-white/50">{c.guard.note}</p>
      </div>
    </div>
  </div>
</section>

<section id="events" class="section-rule px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="mb-12">
      <p class="eyebrow text-[var(--red)]">{c.events.eyebrow}</p>
      <h2 class="display mt-4 text-5xl font-bold md:text-7xl">{c.events.title}</h2>
      <p class="mt-6 max-w-3xl text-black/65">{c.events.intro}</p>
    </div>
    <div class="grid gap-5 md:grid-cols-2">
      {c.events.items.map((e) => (
        <article class="card-stone rounded-3xl p-7">
          <h3 class="text-xl font-bold">{e.title}</h3>
          <p class="mt-3 text-black/60">{e.text}</p>
        </article>
      ))}
    </div>
    <p class="mt-6 text-sm text-black/55">{c.events.note}</p>
  </div>
</section>

<section id="route" class="section-rule px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="grid gap-10 lg:grid-cols-[.8fr_1.2fr]">
      <div class="lg:sticky lg:top-10 lg:self-start">
        <p class="eyebrow text-[var(--red)]">{c.route.eyebrow}</p>
        <h2 class="display mt-5 text-5xl font-bold md:text-7xl">{c.route.title}</h2>
        <p class="mt-6 max-w-md text-black/60">{c.route.note}</p>
      </div>
      <ol class="space-y-5">
        {c.route.steps.map((s, i) => (
          <li class="grid grid-cols-[74px_1fr] gap-5 border-t border-black/15 pt-6">
            <span class="display text-5xl text-[var(--red)]">{String(i + 1).padStart(2, '0')}</span>
            <div>
              <h3 class="text-2xl font-bold">{s.title}</h3>
              <p class="mt-2 text-black/65">{s.text}</p>
            </div>
          </li>
        ))}
      </ol>
    </div>
  </div>
</section>

<section id="photos" class="px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="mb-10">
      <p class="eyebrow text-[var(--red)]">{c.photos.eyebrow}</p>
      <h2 class="display mt-4 text-5xl font-bold md:text-7xl">{c.photos.title}</h2>
    </div>
    <div class="grid gap-5 lg:grid-cols-[1.35fr_.65fr]">
      <figure class="relative min-h-[520px] overflow-hidden rounded-[2rem] bg-black">
        <img src={imageSources[1].src} alt={imageSources[1].alt} loading="lazy" width="1280" height="960" class="absolute inset-0 h-full w-full object-cover" />
        <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-7 pt-20 text-sm text-white">{imageSources[1].credit}</figcaption>
      </figure>
      <div class="grid gap-5">
        <figure class="relative min-h-[300px] overflow-hidden rounded-[2rem] bg-black">
          <img src={imageSources[2].src} alt={imageSources[2].alt} loading="lazy" width="1280" height="943" class="absolute inset-0 h-full w-full object-cover" />
          <figcaption class="absolute inset-x-0 bottom-0 bg-gradient-to-t from-black/80 to-transparent p-6 pt-16 text-sm text-white">{imageSources[2].credit}</figcaption>
        </figure>
        <div class="card-stone rounded-[2rem] p-7">
          <h3 class="text-xl font-bold">{c.photos.shots.length} · {c.photos.title}</h3>
          <ul class="mt-4 space-y-3 text-black/65">
            {c.photos.shots.map((s) => <li>— {s}</li>)}
          </ul>
        </div>
      </div>
    </div>
    <p class="mt-5 text-sm text-black/55">{c.photos.note}</p>
  </div>
</section>

<section id="visit" class="section-rule grid-paper px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="mb-12">
      <p class="eyebrow text-[var(--red)]">{c.visit.eyebrow}</p>
      <h2 class="display mt-4 text-5xl font-bold md:text-7xl">{c.visit.title}</h2>
    </div>
    <div class="grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {c.visit.cards.map((card) => (
        <article class="card-stone rounded-3xl p-7">
          <div class="text-sm font-bold text-[var(--red)]">{card.label}</div>
          <h3 class="mt-4 text-2xl font-bold">{card.title}</h3>
          <p class="mt-3 text-black/60">{card.text}</p>
        </article>
      ))}
    </div>
  </div>
</section>

<section id="transport" class="px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto grid max-w-[1360px] gap-12 lg:grid-cols-2">
    <div>
      <p class="eyebrow text-[var(--red)]">{c.transport.eyebrow}</p>
      <h2 class="display mt-4 text-5xl font-bold">{c.transport.title}</h2>
      <div class="mt-8 space-y-6">
        {c.transport.modes.map((m) => (
          <div class="border-l-2 border-[var(--red)] pl-5">
            <h3 class="font-bold">{m.title}</h3>
            <p class="mt-1 text-black/60">{m.text}</p>
          </div>
        ))}
      </div>
      <a href={transportHref} class="mt-8 inline-block text-sm font-bold text-[var(--red)] underline underline-offset-4">{c.transport.linkLabel}</a>
    </div>
    <div class="rounded-[2rem] bg-[#dfd6c8] p-8 md:p-10">
      <p class="eyebrow text-[var(--red)]">{c.transport.parkingEyebrow}</p>
      <h2 class="display mt-4 text-4xl font-bold">{c.transport.parkingTitle}</h2>
      <p class="mt-6 text-lg">{c.transport.parkingText}</p>
      <div class="mt-7 border-t border-black/15 pt-6 text-sm text-black/60">{c.transport.parkingNote}</div>
    </div>
  </div>
</section>

<section id="map" class="bg-[#1d1916] px-5 py-20 text-white md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="mb-8 grid gap-6 md:grid-cols-2 md:items-end">
      <div>
        <p class="eyebrow text-[#e6b95f]">{c.map.eyebrow}</p>
        <h2 class="display mt-4 text-5xl font-bold md:text-7xl">{c.map.title}</h2>
      </div>
      <address class="not-italic text-white/70 md:text-right">
        <strong class="block font-bold text-white">{attraction.alternateName}</strong>
        <span class="block">{attraction.address.streetAddressEn}, {attraction.address.addressLocalityEn}, {attraction.countryEn} · {attraction.plusCode}</span>
        <span class="block text-white/50">{attraction.address.streetAddress}, {attraction.address.addressLocality}, {attraction.country}</span>
      </address>
    </div>
    <div class="map-frame overflow-hidden rounded-[2rem] border border-white/15 bg-white/5">
      <iframe
        src={attraction.mapsEmbedSrc}
        width="100%"
        height="560"
        style="border:0;"
        allowfullscreen
        loading="lazy"
        referrerpolicy="strict-origin-when-cross-origin"
        title={c.map.title}
      ></iframe>
    </div>
    <div class="mt-6 flex flex-col gap-3 text-sm font-bold text-[#e6b95f] md:flex-row md:items-center md:justify-between">
      <a href={attraction.mapsUrl} target="_blank" rel="noopener noreferrer" class="inline-flex items-center gap-2 hover:text-white">{c.labels.openMap}</a>
      <p class="m-0 font-semibold text-white/55">
        {c.map.officialLabel} <a href={sources[0].url} target="_blank" rel="noopener noreferrer" class="text-[#e6b95f] underline underline-offset-4 hover:text-white">{c.map.officialName}</a>
      </p>
    </div>
  </div>
</section>

<section id="nearby" class="px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="grid gap-12 lg:grid-cols-3">
      <div>
        <p class="eyebrow text-[var(--red)]">{c.nearby.eyebrow}</p>
        <h2 class="display mt-4 text-5xl font-bold">{c.nearby.title}</h2>
        <a href={nearbyHref} class="mt-6 inline-block text-sm font-bold text-[var(--red)] underline underline-offset-4">{c.nearby.linkLabel}</a>
      </div>
      <div class="grid gap-4 md:grid-cols-2 lg:col-span-2">
        {c.nearby.items.map((n) => (
          <article class="card-stone rounded-3xl p-7">
            <h3 class="text-xl font-bold">{n.title}</h3>
            <p class="mt-2 text-black/60">{n.text}</p>
          </article>
        ))}
      </div>
    </div>
    <p class="mt-6 text-sm text-black/55">{c.nearby.note}</p>
  </div>
</section>

<section id="food" class="section-rule px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="grid gap-12 lg:grid-cols-2">
      <div class="rounded-[2rem] bg-[#f8f4ec] p-8 md:p-10">
        <p class="eyebrow text-[var(--red)]">{c.food.eyebrow}</p>
        <h2 class="display mt-4 text-4xl font-bold md:text-5xl">{c.food.title}</h2>
        <p class="mt-5 text-black/65">{c.food.text}</p>
        <div class="mt-7 flex flex-wrap gap-2 text-sm font-bold">
          {c.food.tags.map((t) => <span class="rounded-full border border-black/20 px-4 py-2">{t}</span>)}
        </div>
        <p class="mt-7 text-sm text-black/55">{c.food.note}</p>
      </div>
      <div class="rounded-[2rem] bg-[#ede4d5] p-8 md:p-10">
        <p class="eyebrow text-[var(--red)]">{c.stay.eyebrow}</p>
        <h2 class="display mt-4 text-4xl font-bold md:text-5xl">{c.stay.title}</h2>
        <p class="mt-5 text-black/65">{c.stay.text}</p>
        <ul class="mt-7 space-y-3 text-sm text-black/60">
          {c.stay.tips.map((t) => <li>✓ {t}</li>)}
        </ul>
      </div>
    </div>
  </div>
</section>

<section id="faq" class="bg-[#ded4c5] px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto grid max-w-[1200px] gap-10 lg:grid-cols-[.65fr_1.35fr]">
    <div>
      <p class="eyebrow text-[var(--red)]">{c.faq.eyebrow}</p>
      <h2 class="display mt-4 text-5xl font-bold">{c.faq.title}</h2>
    </div>
    <div class="divide-y divide-black/15 border-y border-black/15">
      {c.faq.items.map((item) => (
        <details class="group py-6">
          <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-bold">
            {item.q}<span class="text-2xl font-normal text-[var(--red)] transition-transform group-open:rotate-45">+</span>
          </summary>
          <p class="max-w-2xl pt-4 text-black/65">{item.a}</p>
        </details>
      ))}
    </div>
  </div>
</section>

<section id="sources" class="px-5 py-20 md:px-10 md:py-28">
  <div class="mx-auto max-w-[1360px]">
    <div class="mb-12 grid gap-6 lg:grid-cols-[.7fr_1.3fr] lg:items-end">
      <div>
        <p class="eyebrow text-[var(--red)]">{c.sources.eyebrow}</p>
        <h2 class="display mt-4 text-5xl font-bold md:text-6xl">{c.sources.title}</h2>
      </div>
      <p class="max-w-xl text-black/60 md:justify-self-end">{c.sources.note}</p>
    </div>
    <ul class="grid gap-4 md:grid-cols-2">
      {sources.map((s) => (
        <li class="card-stone flex items-start justify-between gap-4 rounded-2xl p-6">
          <span class="text-sm font-bold leading-relaxed text-black/70">{s.label}</span>
          <a
            href={s.url}
            target="_blank"
            rel="noopener noreferrer"
            class="whitespace-nowrap rounded-full border border-black/25 px-4 py-2 text-xs font-bold text-black/70 transition hover:bg-black hover:text-white"
            >{c.labels.open}</a
          >
        </li>
      ))}
    </ul>
    <p class="mt-8 text-xs text-black/45">{c.labels.updated} {contentUpdated}. {c.sources.disclaimer}</p>
  </div>
</section>
