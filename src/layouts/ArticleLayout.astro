---
import BaseLayout from './BaseLayout.astro';
import { content } from '../content';
import { contentUpdated } from '../data/site';
import type { ArticleContent, ArticleKey } from '../content';
import { localizedPath, type Locale } from '../i18n';
import { articleSchema, breadcrumbSchema, faqSchema, pageUrl } from '../lib/schema';

interface Props {
  locale: Locale;
  article: ArticleContent;
}

const { locale, article } = Astro.props;
const siteUrl = (Astro.site ? Astro.site.toString() : 'https://alatoosquare.com').replace(/\/$/, '');
const c = content[locale].home;
const selfUrl = pageUrl(siteUrl, locale, article.slug);
const homeHref = localizedPath(locale, '/');

const keys: ArticleKey[] = ['guard', 'transport', 'nearby'];
const related = keys
  .filter((k) => content[locale].articles[k].slug !== article.slug)
  .map((k) => ({ href: localizedPath(locale, content[locale].articles[k].slug), title: content[locale].articles[k].h1 }));

const schema: Record<string, unknown>[] = [
  articleSchema(locale, siteUrl, article),
  breadcrumbSchema(siteUrl, [
    { name: c.breadcrumb.home, url: pageUrl(siteUrl, locale, '/') },
    { name: article.h1, url: selfUrl },
  ]),
];
if (article.faq && article.faq.length > 0) {
  schema.push(faqSchema(article.faq));
}
---

<BaseLayout locale={locale} path={article.slug} title={article.title} description={article.description} schema={schema} variant="solid">
  <article>
    <section class="bg-[#201b17] px-5 py-16 text-white md:px-10 md:py-24">
      <div class="mx-auto max-w-[1100px]">
        <nav aria-label="Breadcrumb" class="mb-6 flex flex-wrap items-center gap-2 text-xs font-bold text-white/55">
          <a href={homeHref} class="hover:text-white">{c.breadcrumb.home}</a>
          <span aria-hidden="true">›</span>
          <span class="text-white/40">{article.h1}</span>
        </nav>
        <p class="eyebrow text-[#e6b95f]">{c.breadcrumb.home} · {c.breadcrumb.city}</p>
        <h1 class="display mt-5 text-4xl font-bold md:text-6xl">{article.h1}</h1>
        <p class="mt-6 max-w-3xl text-lg text-white/80 md:text-xl">{article.lead}</p>
      </div>
    </section>

    <section class="px-5 py-16 md:px-10 md:py-20">
      <div class="mx-auto max-w-[1100px] grid gap-12 lg:grid-cols-[1fr_280px]">
        <div class="space-y-12">
          {article.sections.map((section) => (
            <section>
              <h2 class="display text-3xl font-bold md:text-4xl">{section.heading}</h2>
              {section.paragraphs.map((p) => <p class="mt-4 text-lg leading-relaxed text-black/75">{p}</p>)}
              {section.bullets && (
                <ul class="mt-6 space-y-3 border-l-2 border-[var(--red)] pl-5 text-black/70">
                  {section.bullets.map((b) => <li>{b}</li>)}
                </ul>
              )}
            </section>
          ))}

          {article.faq && article.faq.length > 0 && (
            <section id="faq">
              <h2 class="display text-3xl font-bold md:text-4xl">{article.faqTitle}</h2>
              <div class="mt-6 divide-y divide-black/15 border-y border-black/15">
                {article.faq.map((item) => (
                  <details class="group py-6">
                    <summary class="flex cursor-pointer list-none items-start justify-between gap-6 text-lg font-bold">
                      {item.q}<span class="text-2xl font-normal text-[var(--red)] transition-transform group-open:rotate-45">+</span>
                    </summary>
                    <p class="max-w-2xl pt-4 text-black/65">{item.a}</p>
                  </details>
                ))}
              </div>
            </section>
          )}
        </div>

        <aside class="lg:sticky lg:top-24 lg:self-start">
          <div class="card-stone rounded-3xl p-6">
            <p class="eyebrow text-[var(--red)]">{c.labels.readMore}</p>
            <ul class="mt-4 space-y-3 text-sm font-bold">
              <li><a href={homeHref} class="underline underline-offset-4">{c.breadcrumb.home}</a></li>
              {related.map((r) => <li><a href={r.href} class="underline underline-offset-4">{r.title}</a></li>)}
            </ul>
          </div>
          <p class="mt-6 text-xs text-black/45">{c.labels.updated} {contentUpdated}</p>
          <p class="mt-3 text-xs text-black/45">{c.sources.disclaimer}</p>
        </aside>
      </div>
    </section>
  </article>
</BaseLayout>
